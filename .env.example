# TryFit Environment Configuration Example
# Copy to .env for local runtime. Never commit production credentials.

# API Configuration
TRYFIT_API_PORT=8000
TRYFIT_API_HOST=127.0.0.1
TRYFIT_INFERENCE_MODE=mock

# Database (PostgreSQL)
DATABASE_URL=postgresql://tryfit_user:tryfit_pass@127.0.0.1:5432/tryfit_db

# Queue (Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Private Object Storage (S3 / MinIO)
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=tryfit-private-assets
OBJECT_STORAGE_ACCESS_KEY=tryfit_admin
OBJECT_STORAGE_SECRET_KEY=tryfit_storage_secret

# AI Model (Gated until evaluation signoff)
# MODEL_ID=OOTDiffusion
# MODEL_REVISION=main
